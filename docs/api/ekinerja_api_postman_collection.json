          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nik\": \"198801012015011001\",\n  \"tanggal\": \"2026-09-27\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/integrasi/fingerprint/sync-daily",
              "host": ["{{base_url}}"],
